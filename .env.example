# ─────────────────────────────────────────────
#  SaaS Dental Chatbot – Environment Variables
# ─────────────────────────────────────────────
#
# USAGE:
#   1. Copy this file: cp .env.example .env.local
#   2. Fill in the values below
#   3. Add .env.local to .gitignore (already ignored by default in Vite projects)
#   4. In Vercel: set these via Project Settings → Environment Variables
#
# NEVER commit your actual .env file to the repository.

# ── OpenAI ────────────────────────────────────
# Get your key at: https://platform.openai.com/api-keys
# Model used: gpt-4o-mini (cheap and fast, ~$0.15/1M input tokens)
OPENAI_API_KEY=sk-...

# ── Future: Supabase (not used in V1) ─────────
# Uncomment when implementing multi-tenant / conversation logging
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Future: Tenant identification ─────────────
# Used to identify which clinic is using the API in multi-tenant mode
# TENANT_ID=clinic_001
